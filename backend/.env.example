# --- Database ---
# Local:  mongodb://127.0.0.1:27017/zerodha
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zerodha?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/zerodha
PORT=3002

# --- Login tokens ---
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Allowed website addresses (CORS) ---
# Local:
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
# On Render these become your real addresses, for example:
#   FRONTEND_URL=https://zerodha-frontend.onrender.com
#   DASHBOARD_URL=https://zerodha-dashboard.onrender.com

# --- Optional ---
# DISABLE_PRICE_ENGINE=true   (stops prices from moving)
# TRUST_PROXY=1               (number of proxies in front of the server)
